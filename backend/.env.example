# 複製為 .env 後填值。.env 不可進版控。

# 必填：資料庫連線字串。注意路徑段不可加引號（加了會連不上）。
# 模式 A（本機既有 PostgreSQL 5432）
DATABASE_URL=postgresql+psycopg://postgres:<你的密碼>@localhost:5432/AILearn
# 模式 B（容器，映射 5433）
# DATABASE_URL=postgresql+psycopg://postgres:<你的密碼>@localhost:5433/AILearn

# 必填：session 簽章密鑰（隨機產生，勿外流）
SECRET_KEY=change-me-to-a-random-string

# 選填
FLASK_DEBUG=1
# 連線字串若含特殊字元（@ : / # ?）需 URL 編碼；或在此直接設定原始值供程式使用
# POSTGRES_PASSWORD=
